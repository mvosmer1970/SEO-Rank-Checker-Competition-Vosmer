{
  "name": "seo-rank-tracker",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop app that tracks Google rankings of your own sites through the Search Console API.",
  "author": "Lialis",
  "type": "module",
  "main": "dist/main/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "npm run check && vite build && node scripts/build-main.js",
    "start": "node scripts/start.js",
    "check": "tsc --noEmit",
    "dist": "npm run build && electron-builder --win nsis"
  },
  "build": {
    "appId": "com.lialis.seoranktracker",
    "productName": "SEO Rank Tracker",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SEO Rank Tracker",
      "artifactName": "SEO-Rank-Tracker-Setup-${version}.${ext}"
    }
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  }
}
